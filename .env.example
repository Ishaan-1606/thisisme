# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored - never commit real secrets.

# --- Neon Postgres -----------------------------------------------------------
# Neon dashboard -> your project -> Connection string -> "Pooled connection".
# It must include ?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Private dashboard at /insights -----------------------------------------
# The password you type to unlock the dashboard. Make it long.
INSIGHTS_PASSWORD="change-me-to-something-long"

# Signs the dashboard session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INSIGHTS_SECRET="change-me-random-64-hex-characters"

# --- Privacy -----------------------------------------------------------------
# Salt used to hash visitor IPs. Raw IPs are never stored. Changing this value
# makes all previously stored visitor hashes unlinkable (and resets unique
# visitor counts), which is exactly what you want if it ever leaks.
VISITOR_SALT="change-me-random-string"

# --- Exclude your own visits -------------------------------------------------
# Visit https://yoursite.com/?owner=<OWNER_KEY> once from each of your own
# browsers. Your views are then stored but excluded from every count.
OWNER_KEY="some-private-key"
